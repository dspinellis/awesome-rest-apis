#!/usr/bin/env python3
"""Check that every marked README entry has a sufficiently large JSON example."""

import json
import os
import re
import subprocess
import sys
from pathlib import Path
from urllib.parse import urlsplit


EXAMPLE_LINK = re.compile(
    r"\[[^]]*[Ee]xample[^]]*\]\((https?://[^\s)]+)\)"
)


def ci_exceptions() -> set[str]:
    if os.environ.get("GITHUB_ACTIONS") != "true":
        return set()
    path = Path(__file__).with_name("github-ci-exceptions")
    return {
        line
        for raw_line in path.read_text().splitlines()
        if (line := raw_line.strip().lower()) and not line.startswith("#")
    }


def is_excepted(url: str, exceptions: set[str]) -> bool:
    hostname = (urlsplit(url).hostname or "").lower()
    return any(hostname == item or hostname.endswith(f".{item}") for item in exceptions)


def entries(text: str) -> list[tuple[int, str]]:
    lines = text.splitlines()
    try:
        begin = lines.index("<!--ENTRIES-BEGIN-->")
        end = lines.index("<!--ENTRIES-END-->", begin + 1)
    except ValueError:
        raise ValueError("missing or out-of-order ENTRIES markers") from None
    return [
        (number, line)
        for number, line in enumerate(lines, 1)
        if begin < number - 1 < end and line.startswith("- ")
    ]


def fetch(url: str) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        [
            "curl",
            "--location",
            "--silent",
            "--show-error",
            "--fail",
            "--connect-timeout",
            "10",
            "--max-time",
            "30",
            "--retry",
            "2",
            "--retry-delay",
            "1",
            "--retry-all-errors",
            "--user-agent",
            "awesome-rest-apis-example-check/1.0",
            url,
        ],
        check=False,
        text=True,
        errors="replace",
        capture_output=True,
    )


def collection_size(data: object) -> int:
    """Return the size of the largest collection in a JSON value."""
    if isinstance(data, dict):
        return max([len(data), *(collection_size(value) for value in data.values())])
    if isinstance(data, list):
        return max([len(data), *(collection_size(value) for value in data)])
    return 0


def main() -> int:
    readme = Path(sys.argv[1]) if len(sys.argv) == 2 else Path("README.md")
    if len(sys.argv) > 2:
        print(f"usage: {sys.argv[0]} [README]", file=sys.stderr)
        return 2

    try:
        marked_entries = entries(readme.read_text())
    except (OSError, ValueError) as error:
        print(f"{readme}: {error}", file=sys.stderr)
        return 2

    failures = 0
    skipped = 0
    exceptions = ci_exceptions()
    for line_number, entry in marked_entries:
        match = EXAMPLE_LINK.search(entry)
        if not match:
            failures += 1
            print(f"FAIL {readme}:{line_number}: no Example hyperlink", file=sys.stderr)
            continue

        url = match.group(1)
        if is_excepted(url, exceptions):
            skipped += 1
            print(f"SKIP {readme}:{line_number}: {url} (GitHub CI exception)")
            continue
        response = fetch(url)
        if response.returncode:
            failures += 1
            print(
                f"FAIL {readme}:{line_number}: {url}: {response.stderr.strip()}",
                file=sys.stderr,
            )
            continue
        try:
            data = json.loads(response.stdout)
        except json.JSONDecodeError as error:
            failures += 1
            print(
                f"FAIL {readme}:{line_number}: {url}: invalid JSON: {error}",
                file=sys.stderr,
            )
            continue
        size = collection_size(data)
        if size < 3:
            failures += 1
            print(
                f"FAIL {readme}:{line_number}: {url}: "
                f"largest JSON collection has {size} elements (need 3)",
                file=sys.stderr,
            )
            continue
        print(f"OK   {readme}:{line_number}: {url} ({size} elements)")

    print(
        f"Checked {len(marked_entries) - skipped} entries; "
        f"{skipped} skipped; {failures} failed."
    )
    return int(failures != 0)


if __name__ == "__main__":
    raise SystemExit(main())
