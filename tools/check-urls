#!/usr/bin/env python3
"""Check that every non-example hyperlink in the README returns HTTP 200."""

import re
import subprocess
import sys
from pathlib import Path


LINK = re.compile(r"\[([^]]*)\]\((https?://[^\s)]+)\)")
URL = re.compile(r"\((https?://[^\s)]+)\)")


def status(url: str) -> tuple[int, str]:
    result = subprocess.run(
        [
            "curl",
            "--location",
            "--silent",
            "--show-error",
            "--output",
            "/dev/null",
            "--write-out",
            "%{http_code}",
            "--connect-timeout",
            "10",
            "--max-time",
            "30",
            "--retry",
            "2",
            "--retry-delay",
            "1",
            "--retry-all-errors",
            "--user-agent",
            "awesome-rest-apis-url-check/1.0",
            url,
        ],
        check=False,
        text=True,
        capture_output=True,
    )
    try:
        code = int(result.stdout)
    except ValueError:
        code = 0
    return code, result.stderr.strip()


def main() -> int:
    readme = Path(sys.argv[1]) if len(sys.argv) == 2 else Path("README.md")
    if len(sys.argv) > 2:
        print(f"usage: {sys.argv[0]} [README]", file=sys.stderr)
        return 2

    try:
        text = readme.read_text()
        example_urls = {
            url
            for label, url in LINK.findall(text)
            if re.search(r"[Ee]xample", label)
        }
        urls = list(
            dict.fromkeys(
                url
                for url in URL.findall(text)
                if url not in example_urls
            )
        )
    except OSError as error:
        print(f"{readme}: {error}", file=sys.stderr)
        return 2

    failures = 0
    for url in urls:
        code, error = status(url)
        if code == 200:
            print(f"OK   {url}")
        else:
            failures += 1
            detail = f" ({error})" if error else ""
            print(f"FAIL {url}: HTTP {code}{detail}", file=sys.stderr)

    print(f"Checked {len(urls)} URLs; {failures} failed.")
    return int(failures != 0)


if __name__ == "__main__":
    raise SystemExit(main())
