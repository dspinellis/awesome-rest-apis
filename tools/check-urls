#!/usr/bin/env python3
"""Check that every hyperlink in the marked README list returns HTTP 200."""

import re
import subprocess
import sys
from pathlib import Path


LINK = re.compile(r"\[[^]]*\]\((https?://[^\s)]+)\)")


def entries(text: str) -> str:
    try:
        return text.split("<!--ENTRIES-BEGIN-->", 1)[1].split(
            "<!--ENTRIES-END-->", 1
        )[0]
    except IndexError:
        raise ValueError("missing or out-of-order ENTRIES markers") from None


def status(url: str) -> tuple[int, str]:
    result = subprocess.run(
        [
            "curl",
            "--location",
            "--silent",
            "--show-error",
            "--output",
            "/dev/null",
            "--write-out",
            "%{http_code}",
            "--connect-timeout",
            "10",
            "--max-time",
            "30",
            "--user-agent",
            "awesome-rest-apis-url-check/1.0",
            url,
        ],
        check=False,
        text=True,
        capture_output=True,
    )
    try:
        code = int(result.stdout)
    except ValueError:
        code = 0
    return code, result.stderr.strip()


def main() -> int:
    readme = Path(sys.argv[1]) if len(sys.argv) == 2 else Path("README.md")
    if len(sys.argv) > 2:
        print(f"usage: {sys.argv[0]} [README]", file=sys.stderr)
        return 2

    try:
        urls = list(dict.fromkeys(LINK.findall(entries(readme.read_text()))))
    except (OSError, ValueError) as error:
        print(f"{readme}: {error}", file=sys.stderr)
        return 2

    failures = 0
    for url in urls:
        code, error = status(url)
        if code == 200:
            print(f"OK   {url}")
        else:
            failures += 1
            detail = f" ({error})" if error else ""
            print(f"FAIL {url}: HTTP {code}{detail}", file=sys.stderr)

    print(f"Checked {len(urls)} URLs; {failures} failed.")
    return int(failures != 0)


if __name__ == "__main__":
    raise SystemExit(main())
