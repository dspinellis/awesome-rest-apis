#!/usr/bin/env python3
"""Check that every non-example hyperlink in the README returns HTTP 200."""

import os
import re
import subprocess
import sys
from pathlib import Path
from urllib.parse import urlsplit


LINK = re.compile(r"\[([^]]*)\]\((https?://[^\s)]+)\)")
URL = re.compile(r"\((https?://[^\s)]+)\)")


def ci_exceptions() -> set[str]:
    if os.environ.get("GITHUB_ACTIONS") != "true":
        return set()
    path = Path(__file__).with_name("github-ci-exceptions")
    return {
        line
        for raw_line in path.read_text().splitlines()
        if (line := raw_line.strip().lower()) and not line.startswith("#")
    }


def is_excepted(url: str, exceptions: set[str]) -> bool:
    hostname = (urlsplit(url).hostname or "").lower()
    return any(hostname == item or hostname.endswith(f".{item}") for item in exceptions)


def status(url: str) -> tuple[int, str]:
    result = subprocess.run(
        [
            "curl",
            "--location",
            "--silent",
            "--show-error",
            "--output",
            "/dev/null",
            "--write-out",
            "%{http_code}",
            "--connect-timeout",
            "10",
            "--max-time",
            "30",
            "--retry",
            "2",
            "--retry-delay",
            "1",
            "--retry-all-errors",
            "--user-agent",
            "awesome-rest-apis-url-check/1.0",
            url,
        ],
        check=False,
        text=True,
        capture_output=True,
    )
    try:
        code = int(result.stdout)
    except ValueError:
        code = 0
    return code, result.stderr.strip()


def main() -> int:
    readme = Path(sys.argv[1]) if len(sys.argv) == 2 else Path("README.md")
    if len(sys.argv) > 2:
        print(f"usage: {sys.argv[0]} [README]", file=sys.stderr)
        return 2

    try:
        text = readme.read_text()
        example_urls = {
            url
            for label, url in LINK.findall(text)
            if re.search(r"[Ee]xample", label)
        }
        urls = list(
            dict.fromkeys(
                url
                for url in URL.findall(text)
                if url not in example_urls
            )
        )
    except OSError as error:
        print(f"{readme}: {error}", file=sys.stderr)
        return 2

    failures = 0
    skipped = 0
    exceptions = ci_exceptions()
    for url in urls:
        if is_excepted(url, exceptions):
            skipped += 1
            print(f"SKIP {url} (GitHub CI exception)")
            continue
        code, error = status(url)
        if code == 200:
            print(f"OK   {url}")
        else:
            failures += 1
            detail = f" ({error})" if error else ""
            print(f"FAIL {url}: HTTP {code}{detail}", file=sys.stderr)

    print(f"Checked {len(urls) - skipped} URLs; {skipped} skipped; {failures} failed.")
    return int(failures != 0)


if __name__ == "__main__":
    raise SystemExit(main())
